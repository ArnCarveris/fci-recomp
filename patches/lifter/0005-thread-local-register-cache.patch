Subject: Take the register state's thread-local addresses once per function

MSVC recomputes a thread-local variable's address at every access. Each translated function now
starts with RECOMP_TLS_CACHE, and the translated files read the register state through those
addresses: the game's generated C compiles about three times faster, with the same storage.

---
diff --git a/templates/runtime/recomp_types.h b/templates/runtime/recomp_types.h
--- a/templates/runtime/recomp_types.h
+++ b/templates/runtime/recomp_types.h
@@ -1434,4 +1434,58 @@
 void recomp_unimpl(const char *text, uint32_t va);
 #define RECOMP_UNIMPL(_text, _va) recomp_unimpl((_text), (_va))
 
+/* Translated functions take the addresses of the thread-local register state once on entry
+ * (RECOMP_TLS_CACHE): MSVC otherwise recomputes them at every access, slowing compiles. */
+#define RECOMP_TLS_STATE(X) \
+    X(uint32_t, g_eax) X(uint32_t, g_ecx) X(uint32_t, g_edx) X(uint32_t, g_esp) \
+    X(uint32_t, g_ebx) X(uint32_t, g_esi) X(uint32_t, g_edi) X(uint32_t, g_ebp) \
+    X(uint32_t, g_seh_ebp) X(uint32_t, g_fs_base) X(int, g_df) X(int, g_fp_top) \
+    X(uint16_t, g_fp_control_word) X(int, g_fp_cmp) X(uint16_t, g_fp_cc) \
+    X(RecompXmm, g_xmm0) X(RecompXmm, g_xmm1) X(RecompXmm, g_xmm2) X(RecompXmm, g_xmm3) \
+    X(RecompXmm, g_xmm4) X(RecompXmm, g_xmm5) X(RecompXmm, g_xmm6) X(RecompXmm, g_xmm7) \
+    X(RecompMmx, g_mm0) X(RecompMmx, g_mm1) X(RecompMmx, g_mm2) X(RecompMmx, g_mm3) \
+    X(RecompMmx, g_mm4) X(RecompMmx, g_mm5) X(RecompMmx, g_mm6) X(RecompMmx, g_mm7)
+#ifdef RECOMP_TLS_CACHED
+#define RECOMP_TLS_ADDRESS(type, name) static inline type *recomp_tls_##name(void) { return &name; }
+RECOMP_TLS_STATE(RECOMP_TLS_ADDRESS)
+static inline double *recomp_tls_g_fp_stack(void) { return g_fp_stack; }
+#define RECOMP_TLS_POINTER(type, name) type *const p_##name = recomp_tls_##name();
+#define RECOMP_TLS_CACHE \
+    RECOMP_TLS_STATE(RECOMP_TLS_POINTER) double *const p_g_fp_stack = recomp_tls_g_fp_stack()
+#define g_eax (*p_g_eax)
+#define g_ecx (*p_g_ecx)
+#define g_edx (*p_g_edx)
+#define g_esp (*p_g_esp)
+#define g_ebx (*p_g_ebx)
+#define g_esi (*p_g_esi)
+#define g_edi (*p_g_edi)
+#define g_ebp (*p_g_ebp)
+#define g_seh_ebp (*p_g_seh_ebp)
+#define g_fs_base (*p_g_fs_base)
+#define g_df (*p_g_df)
+#define g_fp_top (*p_g_fp_top)
+#define g_fp_control_word (*p_g_fp_control_word)
+#define g_fp_cmp (*p_g_fp_cmp)
+#define g_fp_cc (*p_g_fp_cc)
+#define g_fp_stack p_g_fp_stack
+#define g_xmm0 (*p_g_xmm0)
+#define g_xmm1 (*p_g_xmm1)
+#define g_xmm2 (*p_g_xmm2)
+#define g_xmm3 (*p_g_xmm3)
+#define g_xmm4 (*p_g_xmm4)
+#define g_xmm5 (*p_g_xmm5)
+#define g_xmm6 (*p_g_xmm6)
+#define g_xmm7 (*p_g_xmm7)
+#define g_mm0 (*p_g_mm0)
+#define g_mm1 (*p_g_mm1)
+#define g_mm2 (*p_g_mm2)
+#define g_mm3 (*p_g_mm3)
+#define g_mm4 (*p_g_mm4)
+#define g_mm5 (*p_g_mm5)
+#define g_mm6 (*p_g_mm6)
+#define g_mm7 (*p_g_mm7)
+#else
+#define RECOMP_TLS_CACHE (void)0
+#endif
+
 #endif /* RECOMP_TYPES_H */
diff --git a/tools/recomp/translator.py b/tools/recomp/translator.py
--- a/tools/recomp/translator.py
+++ b/tools/recomp/translator.py
@@ -2214,6 +2214,7 @@
         # Function signature
         lines.append(f"{ret_type} {name}({param_str})")
         lines.append(f"{{")
+        lines.append("    RECOMP_TLS_CACHE;")
         if func_addr in ENTRY_HOOKS:
             lines.append(f"    extern void sub_{func_addr:08X}_enter(void);")
             lines.append(f"    sub_{func_addr:08X}_enter();")
@@ -3151,6 +3152,7 @@
                 " */",
                 "",
                 "#define RECOMP_GENERATED_CODE",
+                "#define RECOMP_TLS_CACHED",
                 f'#include "{header_name}"',
                 '#include <math.h>',
                 "",

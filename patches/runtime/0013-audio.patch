+                if (++blocks >= 1875) {
+                    static ULONGLONG last;
+                    extern int fci_apu_drops, fci_apu_underruns, fci_apu_starved;
+                    ULONGLONG now = GetTickCount64();
+                    fprintf(stderr, "[APU] output peak %d of 32767 over the last %d blocks (10s of audio in "
+                            "%llu ms, %d buffers dropped, %d voice underruns, %d output starved)\n", peak, blocks,
+                            last ? now - last : 0ULL, fci_apu_drops, fci_apu_underruns, fci_apu_starved);
+                    fci_apu_underruns = fci_apu_starved = 0;
+                    last = now;
+                    fci_apu_drops = 0;
+                    peak = blocks = 0;
+                }
+            }
+        }
+        memcpy(acc + acc_n, d->monitor.frame_buf, sizeof(d->monitor.frame_buf));
+        acc_n += MIXER_FRAME_SAMPLES;
+        memset(d->monitor.frame_buf, 0, sizeof(d->monitor.frame_buf));
+        if (acc_n + MIXER_FRAME_SAMPLES > buf_size) {
+            extern int fci_apu_drops;
+            if (!xa2_submit_samples((const int16_t *)acc, acc_n))
+                fci_apu_drops++;
+            acc_n = 0;
+        }
+        return;
+    }
+    /* Upstream XAudio2 path, no longer reached */

-        if (count < 0) break;
-        if (count == 0) return -1;
-        sample_count += count;
+        while (rs[v].n < ip + 2) {
+            int active = voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
+                                        NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE);
+            int count;
+            if (!active || rs[v].n >= 64)
+                break;
+            count = voice_get_samples(d, v, &rs[v].src[rs[v].n], 64 - rs[v].n);
+            if (count <= 0)

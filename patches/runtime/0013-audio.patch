+                    d->monitor.frame_buf[i][0] = s;
+                    d->monitor.frame_buf[i][1] = s;
+                    g_test_tone.phase += g_test_tone.phase_inc;
+                    if (g_test_tone.phase >= 2.0 * M_PI)
+                        g_test_tone.phase -= 2.0 * M_PI;

-                    fflush(stderr);
-                    bridge_run_thread_inline(fn, start_context1, start_context2);
+                    extern void fci_thread_stop(const char *why, uint32_t routine);
+                    fci_thread_stop("PsCreateSystemThreadEx out of thread stacks", start_routine);
                 } else {
                     HANDLE th = bridge_spawn_thread(fn, start_context1,
                                                     start_context2, stack_top);
@@ -644,8 +641,8 @@
                 }

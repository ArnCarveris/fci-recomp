Subject: Hard disk partitions: images grow on demand, volume queries answered from FATX

The partition images are created empty and grow only by what the game writes; never-written
sectors read as zeros and a partition's length comes from the partition table (src/fci_disk.c).
XAPI formats the utility partition, dismounts it (FSCTL_DISMOUNT_VOLUME at 004AD205) and checks
its cluster size through FileFsSizeInformation (004AC838); both are answered for partition
images, from the FATX superblock the game wrote. A trailing separator after
\Device\Harddisk0\PartitionN opens the volume's root directory, as on the console, and
Partition1 (the E: volume) maps to the writable save folder.

---
diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -3424,6 +3424,16 @@
     }
     g_eax = (uint32_t)xbox_NtReadFile(handle, NULL, NULL, NULL, &ios,
                 XBOX_TO_NATIVE(buffer_va), length, poff);
+    {
+        extern uint32_t fci_partition_read_fill(HANDLE h, void *buf, uint32_t length,
+                const LARGE_INTEGER *off, uint32_t status, uint32_t *got);
+        uint32_t got = (uint32_t)ios.Information;
+        uint32_t st = fci_partition_read_fill(handle, XBOX_TO_NATIVE(buffer_va), length,
+                                               poff, (uint32_t)ios.Status, &got);
+        if (st != (uint32_t)ios.Status || got != (uint32_t)ios.Information) {
+            ios.Status = (NTSTATUS)st; ios.Information = got; g_eax = st;
+        }
+    }
 
     /* What a read actually delivered. A decoder that rejects its input cannot
      * say whether the bytes were wrong or the read was, and the two look
@@ -3563,6 +3573,16 @@
         bridge_write_iostatus(ios_va, (NTSTATUS)0xC0000005, 0);
         g_eax = 0xC0000005u;                 /* STATUS_ACCESS_VIOLATION */
         return;
+    }
+    {
+        extern int fci_volume_size(HANDLE h, void *out, uint32_t length, uint32_t cls,
+                                   uint32_t *status, uint32_t *written);
+        uint32_t st, n;
+        if (fci_volume_size(handle, XBOX_TO_NATIVE(info_va), length, infoclass, &st, &n)) {
+            bridge_write_iostatus(ios_va, st, n);
+            g_eax = st;
+            return;
+        }
     }
     g_eax = (uint32_t)xbox_NtQueryVolumeInformationFile(handle, &ios,
                 XBOX_TO_NATIVE(info_va), length,
@@ -3855,8 +3875,11 @@
             return;
         }
         size.QuadPart = 0;
-        if (h && h != INVALID_HANDLE_VALUE)
-            GetFileSizeEx(h, &size);
+        if (h && h != INVALID_HANDLE_VALUE) {
+            extern int fci_partition_length(HANDLE h, LARGE_INTEGER *length);
+            if (!fci_partition_length(h, &size))
+                GetFileSizeEx(h, &size);
+        }
         BRIDGE_MEM32(out_va +  0) = 0;                       /* StartingOffset */
         BRIDGE_MEM32(out_va +  4) = 0;
         BRIDGE_MEM32(out_va +  8) = (uint32_t)size.LowPart;  /* PartitionLength */
@@ -3880,6 +3903,15 @@
 {
     uint32_t fsctl = STACK_ARG(5);
     uint32_t ios_va = STACK_ARG(4);
+    {
+        extern int fci_partition_fsctl(HANDLE h, uint32_t fsctl, uint32_t *status);
+        uint32_t st;
+        if (fci_partition_fsctl(bridge_resolve_handle(STACK_ARG(0)), fsctl, &st)) {
+            bridge_write_iostatus(ios_va, st, 0);
+            g_eax = st;
+            return;
+        }
+    }
     fprintf(stderr, "  [FILE] NtFsControlFile(0x%X) - stub\n", fsctl);
     bridge_write_iostatus(ios_va, 0xC00000BBu, 0);
     g_eax = 0xC00000BBu;
diff --git a/src/kernel/kernel_path.c b/src/kernel/kernel_path.c
--- a/src/kernel/kernel_path.c
+++ b/src/kernel/kernel_path.c
@@ -47,7 +47,7 @@
 
 static const path_rule s_rules[] = {
     { "\\Device\\CdRom0\\",                   0, NULL,         NULL          },
-    { "\\Device\\Harddisk0\\Partition1\\",    0, NULL,         NULL          },
+    { "\\Device\\Harddisk0\\Partition1\\",    1, NULL,         NULL          },
     /* The rest of the disk. Partition 0 is the whole raw device, 2 holds
      * system data, and 3-5 are the per-title caches behind X:, Y: and Z:.
      * Without these the path layer reported "Unrecognized Xbox path" and
@@ -260,9 +260,8 @@
         return FALSE;
 
     rest = xbox_path + len + 1;
-    /* Nothing below it, allowing for a single trailing separator. */
-    if (*rest == '\\' || *rest == '/')
-        rest++;
+    /* Only the bare device is the raw partition; a trailing separator names the
+     * volume's root directory. */
     if (*rest != '\0')
         return FALSE;
 
@@ -366,9 +365,7 @@
                     continue;
                 DeviceIoControl(h, FSCTL_SET_SPARSE, NULL, 0, NULL, 0,
                                 &ret, NULL);
-                end.QuadPart = (LONGLONG)(part_sectors[p] * 512ull);
-                if (SetFilePointerEx(h, end, NULL, FILE_BEGIN))
-                    SetEndOfFile(h);
+                (void)end; /* not pre-extended; see fci_disk.c */
                 CloseHandle(h);
             }
         }

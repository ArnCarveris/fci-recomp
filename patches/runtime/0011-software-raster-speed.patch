 {
-    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+    static const uint8_t *s_mem_base;
+    const uint8_t *mem = s_mem_base ? s_mem_base
+                       : (s_mem_base = (const uint8_t *)xbox_GetMemoryOffset());
     const uint8_t *p;
     uint32_t fmt, base = t->offset + face_offset;
 
@@ -893,7 +897,7 @@
         uint32_t bx = u >> 2, by = v >> 2, bw = (t->width + 3) >> 2;
         const uint8_t *blk = mem + base + ((size_t)by * bw + bx) * bb;
         uintptr_t key = (uintptr_t)blk;
-        size_t slot = ((key / bb) ^ (key >> 16)) & 4095;
+        size_t slot = ((key >> (bb == 8 ? 3 : 4)) ^ (key >> 16)) & 4095;
         uint64_t raw[2] = {0, 0};
         memcpy(raw, blk, bb);
         if (cache[slot].key != key || cache[slot].fmt != fmt
@@ -1138,6 +1142,7 @@
 }
 
 static uint32_t pack_color(const float c[4]);
+static int s_xf_rows_active;   /* workers running, no shared stats */
 

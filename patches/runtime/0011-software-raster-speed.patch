+    if (mode == 1 && !(size & (size - 1)))   /* power of two */
+        return c & (size - 1);
     if (mode == 1)                         /* wrap */
         return (uint32_t)(((sc % n) + n) % n);
     return sc < 0 ? 0u : (sc >= n ? size - 1 : c);   /* clamp, and the rest */
@@ -869,7 +871,9 @@

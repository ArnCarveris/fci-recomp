Subject: Quick reboot into the game or the map editor continues in a new instance

The game switches modes (Story Mode level start, the map editor in ige.xbe) by rebooting with a
launch data page, HalReturnToFirmware(2). The page is carried to a new instance
(fci_relaunch, src/fci_manual.c), and a started instance reads it back from RECOMP_LAUNCH_DATA.

---
diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -263,6 +263,25 @@
             }
         } else {
             BRIDGE_MEM32(XBOX_KERNEL_DATA_BASE + KDATA_LAUNCH_DATA_PAGE) = 0;
+        }
+        {
+            const char *saved = getenv("RECOMP_LAUNCH_DATA");
+            FILE *f = saved && *saved ? fopen(saved, "rb") : NULL;
+            if (f) {
+                uint32_t page = xbox_HeapAlloc(0x1000, 4096), i;
+                int c = 0;
+                for (i = 0; page && i < 0x1000 && (c = fgetc(f)) != EOF; i++)
+                    BRIDGE_MEM8(page + i) = (uint8_t)c;
+                fclose(f);
+                remove(saved);
+                if (page && i == 0x1000) {
+                    BRIDGE_MEM32(XBOX_KERNEL_DATA_BASE + KDATA_LAUNCH_DATA_PAGE) = page;
+                    fprintf(stderr, "  Launch data: page from %s at 0x%08X (type %u, title %08X)\n",
+                            saved, page, BRIDGE_MEM32(page), BRIDGE_MEM32(page + 4));
+                } else {
+                    fprintf(stderr, "  Launch data: %s is not a 4KiB page; ignored\n", saved);
+                }
+            }
         }
     }
 
@@ -1325,6 +1344,23 @@
             fprintf(stderr, "\n");
         } else {
             fprintf(stderr, "  [KERNEL] no launch data page set\n");
+        }
+    }
+
+    {   /* a quick reboot into this same image continues in a new instance */
+        extern void fci_relaunch(uint32_t page);
+        uint32_t page = BRIDGE_MEM32(XBOX_KERNEL_DATA_BASE + KDATA_LAUNCH_DATA_PAGE);
+        if (routine == 2 && page) {
+            char path[64];
+            uint32_t i;
+            for (i = 0; i < sizeof(path) - 1; i++) {
+                uint8_t c = BRIDGE_MEM8(page + 8 + i);
+                if (!c) break;
+                path[i] = (char)c;
+            }
+            path[i] = 0;
+            fprintf(stderr, "[FCI] requested launch %s\n", path);
+            fci_relaunch(page);
         }
     }
 
